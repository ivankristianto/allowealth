---
import ProtectedLayout from '@/layouts/ProtectedLayout.astro';
import Button from '@/components/atoms/Button.astro';
import { verifyOAuthQueryParams } from '@better-auth/oauth-provider';
import { db, getActiveSchema } from '@/db';
import { auth } from '@/lib/auth/server';
import { getRedirectTarget, submitOAuthConsent } from '@/lib/auth/oauth-consent';
import { getConsentScopeChoices } from '@/lib/mcp-oauth-scopes';
import { eq } from 'drizzle-orm';

const schema = getActiveSchema();

// The form posts back to this page; Better Auth returns the URL to continue to.
let consentError = '';
let postedScopes: Set<string> | null = null;
if (Astro.request.method === 'POST') {
  // Kept so a refused submission shows the boxes as the user left them.
  const posted = await Astro.request.clone().formData();
  postedScopes = new Set(posted.getAll('scope').map(String));
  const result = await submitOAuthConsent(Astro.request);
  if ('url' in result) {
    return Astro.redirect(result.url);
  }
  consentError = result.error;
}

// The OAuth provider redirects here with a signed copy of the authorize query.
// It is verified before rendering and posted back verbatim as `oauth_query`.
const oauthQuery = Astro.url.search.slice(1);
const { secret } = await auth.$context;
const isValidRequest = oauthQuery !== '' && (await verifyOAuthQueryParams(oauthQuery, secret));
const clientId = isValidRequest ? (Astro.url.searchParams.get('client_id') ?? '') : '';
const redirectTarget = isValidRequest
  ? getRedirectTarget(Astro.url.searchParams.get('redirect_uri'))
  : '';
const requestedScopes = isValidRequest
  ? (Astro.url.searchParams.get('scope') ?? '').split(' ').filter(Boolean)
  : [];
const scopeChoices = getConsentScopeChoices(requestedScopes);
const isTicked = (scope: string) => postedScopes?.has(scope) ?? true;
const anyPermissionTicked = scopeChoices.groups.some((group) =>
  group.permissions.some((permission) => isTicked(permission.scope))
);

// Look up the client display name
let clientName = clientId;
if (clientId) {
  const client = await db.query.oauthClient.findFirst({
    where: eq(schema.oauthClient.clientId, clientId),
    columns: { name: true },
  });
  if (client?.name) clientName = client.name;
}
---

<ProtectedLayout title="Authorize Access" currentPath="/oauth/authorize">
  <div class="flex min-h-screen items-center justify-center p-4">
    <div class="card bg-base-100 shadow-xl w-full max-w-md">
      <div class="card-body gap-6" data-oauth-consent>
        {isValidRequest ? (
          <>
            <div class="text-center">
              <h1 class="text-xl font-bold">{clientName}</h1>
              <p class="text-base-content/60 text-sm mt-1">
                wants access to your Allowealth account
              </p>
              {redirectTarget && (
                <p class="text-base-content/70 text-sm mt-2" data-testid="oauth-redirect-target">
                  Approving sends access to{' '}
                  <span class="font-mono font-medium break-all">{redirectTarget}</span>
                </p>
              )}
            </div>

            <form method="post" class="space-y-5" data-oauth-consent-form>
              <input type="hidden" name="oauth_query" value={oauthQuery} />

              {scopeChoices.required.length > 0 && (
                <fieldset class="space-y-2">
                  <legend class="mb-1 text-sm font-medium">Always included</legend>
                  {scopeChoices.required.map((choice) => (
                    <label class="flex items-start gap-3">
                      <input
                        type="checkbox"
                        class="checkbox checkbox-sm mt-0.5 rounded-md"
                        checked
                        disabled
                      />
                      <span class="text-sm">
                        <span class="font-medium">{choice.label}</span>
                        {choice.description && (
                          <span class="block text-xs text-base-content/60">
                            {choice.description}
                          </span>
                        )}
                      </span>
                    </label>
                  ))}
                </fieldset>
              )}

              {scopeChoices.groups.length > 0 && (
                <fieldset
                  class="space-y-4 rounded-2xl border border-base-300 bg-base-200/40 p-3 sm:p-4"
                  aria-describedby="oauth-permissions-hint"
                  data-oauth-permissions
                >
                  <legend class="px-1 text-sm font-medium">Permissions</legend>
                  <p id="oauth-permissions-hint" class="text-xs text-base-content/60">
                    Untick anything you do not want {clientName} to do. Connect again to change this
                    later.
                  </p>
                  {scopeChoices.groups.map((group) => (
                    <fieldset class="space-y-2">
                      <legend class="mb-1 text-xs font-semibold text-base-content/70">
                        {group.label}
                      </legend>
                      {group.permissions.map((permission) => (
                        <label class="flex items-start gap-3 cursor-pointer">
                          <input
                            type="checkbox"
                            name="scope"
                            value={permission.scope}
                            class="checkbox checkbox-sm mt-0.5 rounded-md"
                            checked={isTicked(permission.scope)}
                          />
                          <span class="text-sm">
                            <span class="font-medium">{permission.label}</span>
                            <span class="block text-xs text-base-content/60">
                              {permission.description}
                            </span>
                          </span>
                        </label>
                      ))}
                    </fieldset>
                  ))}
                </fieldset>
              )}

              <div
                class="alert alert-warning text-sm"
                role="status"
                hidden={anyPermissionTicked}
                data-oauth-no-permissions
              >
                <span>
                  With no permissions, {clientName} can connect but cannot read or change anything.
                </span>
              </div>

              {consentError && (
                <div class="alert alert-error" role="alert">
                  <span>{consentError}</span>
                </div>
              )}

              <div class="flex gap-3">
                <Button
                  type="submit"
                  name="accept"
                  value="false"
                  variant="outline"
                  className="flex-1"
                >
                  Deny
                </Button>
                <Button
                  type="submit"
                  name="accept"
                  value="true"
                  variant="primary"
                  className="flex-1"
                >
                  Authorize
                </Button>
              </div>
            </form>
          </>
        ) : (
          <div class="text-center space-y-2">
            <h1 class="text-xl font-bold">Authorization Link Expired</h1>
            <p class="text-base-content/60 text-sm">
              This authorization request is invalid or has expired. Start again from Security →
              Connected Apps.
            </p>
            <Button href="/security" variant="primary">
              Go to Security
            </Button>
          </div>
        )}
      </div>
    </div>
  </div>
</ProtectedLayout>

<script>
  import { syncNoPermissionsWarning } from '@/lib/oauth-consent-form.client';
  import { onPageReady } from '@/lib/page-lifecycle.client';

  onPageReady((signal) => {
    document.querySelectorAll<HTMLFormElement>('[data-oauth-consent-form]').forEach((form) => {
      form.addEventListener('change', () => syncNoPermissionsWarning(form), { signal });
    });
  });
</script>
