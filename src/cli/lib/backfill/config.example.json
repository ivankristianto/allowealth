      "category": "Cat3",
      "owner": "OwnerB"
    },
    {
      "match": "Word",
      "owner": "OwnerB"
    }
  ],
  "salaryRouting": [
    {
      "category": "IncSalaryA",
      "account": "Bank2 OwnerA USD"
    },
    {
      "category": "IncSalaryB",
      "account": "Bank1 OwnerB"
    }
  ],
  "incomeRouting": [
    {
      "match": ["Coupon", "OwnerA"],
      "account": "Bank2 OwnerA USD",
