---
import { RotateCcwClock } from '@lucide/astro';
import { toneDotClasses, type SecurityEvent } from '@/services/audit-log.service';

export interface Props {
  events: SecurityEvent[];
  /** Set when the list shows only one token's events. */
  tokenFilter?: { name: string } | null;
}

const { events, tokenFilter = null } = Astro.props;
---

<section
  id="recent-activity"
  class="card bg-base-200/60 border border-base-300 shadow scroll-mt-24"
  data-testid="recent-activity-card"
>
  <div class="card-body p-6 space-y-5">
    <div class="flex items-center gap-2 text-base-content/70">
      <RotateCcwClock size={18} class="stroke-current" aria-hidden="true" />
      <h3 class="text-sm font-semibold">Recent User Activities</h3>
    </div>

    {tokenFilter && (
      <div class="flex flex-wrap items-center justify-between gap-2 rounded-xl bg-base-100 px-3 py-2 text-sm">
        <span class="text-base-content/70">
          Only activity via <strong class="text-base-content">{tokenFilter.name}</strong>
        </span>
        <a href="/security#recent-activity" class="link link-hover text-xs">
          Show all activity
        </a>
      </div>
    )}

    <div class="space-y-4">
      {events.length === 0 ? (
        <p class="text-sm text-base-content/50 text-center py-2">
          {tokenFilter ? 'No activity from this token yet.' : 'No recent security activity found.'}
        </p>
      ) : (
        events.map((event) => (
          <div class="flex items-center justify-between gap-4 text-sm" data-security-event>
            <div class="flex items-center gap-3 min-w-0">
              <span class={`w-2 h-2 rounded-full shrink-0 ${toneDotClasses[event.tone]}`} />
              <span class="min-w-0">
                <span class="text-base-content/70">{event.label}</span>
                {event.via && (
                  <span class="block text-xs text-base-content/50 truncate">via {event.via}</span>
                )}
              </span>
            </div>
            <span class="text-xs text-base-content/50 uppercase tracking-wide shrink-0">
              {event.timestamp}
            </span>
          </div>
        ))
      )}
    </div>

    <a
      href="/api/security/audit-logs"
      class="btn btn-outline btn-sm rounded-lg w-full text-xs uppercase tracking-widest"
    >
      Download Security Audit
    </a>
  </div>
</section>
