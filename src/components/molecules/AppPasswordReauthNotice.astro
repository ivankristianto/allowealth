---
/** Shown in place of an app password form when the session is older than the reauth window. */
import { TriangleAlert } from '@lucide/astro';
import Button from '@/components/atoms/Button.astro';

export interface Props {
  message: string;
}

const { message } = Astro.props;
---

<div class="space-y-4 pt-4" data-app-password-reauth>
  <div class="alert alert-warning text-sm" role="alert">
    <TriangleAlert size={20} aria-hidden="true" />
    <span>{message} Signing out also disconnects your OAuth connected apps.</span>
  </div>
  <div class="modal-action">
    <button type="button" class="btn btn-ghost btn-sm rounded-2xl" data-close-app-password-dialog>
      Cancel
    </button>
    <Button
      type="button"
      variant="accent"
      size="sm"
      className="rounded-2xl"
      data-app-password-sign-in-again
    >
      Sign in again
    </Button>
  </div>
</div>
