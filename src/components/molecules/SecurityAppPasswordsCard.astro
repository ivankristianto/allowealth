---
/**
 * App passwords (personal access tokens) for MCP clients that cannot run the
 * OAuth flow. The list refreshes through GET /api/user/app-passwords?_render=html.
 */
import { Copy, KeyRound, Plus, TriangleAlert } from '@lucide/astro';
import Button from '@/components/atoms/Button.astro';
import SecurityCard from '@/components/molecules/SecurityCard.astro';
import SecurityAppPasswordsListPartial from '@/components/partials/SecurityAppPasswordsListPartial.astro';
import { APP_PASSWORD_NAME_MAX_LENGTH, DEFAULT_APP_PASSWORD_EXPIRY } from '@/lib/mcp-app-password';
import type { AppPasswordSummary } from '@/services/mcp-app-password.service';

export interface Props {
  appPasswords: AppPasswordSummary[];
  recentSignIn: boolean;
}

const { appPasswords, recentSignIn } = Astro.props;

const expiryChoices = [
  { value: '30', label: '30 days' },
  { value: '90', label: '90 days' },
  { value: '365', label: '1 year' },
  { value: 'never', label: 'No expiry' },
];
---

<SecurityCard
  title="App Passwords"
  subtitle="Long-lived tokens for scripts and AI agents that use MCP"
  iconVariant="warning"
  data-app-passwords-card
  data-testid="app-passwords-card"
>
  <KeyRound slot="icon" size={20} class="stroke-current" aria-hidden="true" />

  <span slot="header-action">
    <Button type="button" variant="outline" size="sm" data-open-create-app-password>
      <Plus size={16} class="stroke-current" aria-hidden="true" />
      Create
    </Button>
  </span>

  <div class="space-y-4">
    <p class="text-sm text-base-content/60">
      Use one as <code class="font-mono text-xs">Authorization: Bearer aw_pat_…</code> on
      <code class="font-mono text-xs">/api/mcp</code>, or as
      <code class="font-mono text-xs">ALLOWEALTH_ACCESS_TOKEN</code> for the local MCP server. App
      passwords survive sign-out and password changes. Revoke them here when you no longer need
      them.
    </p>

    <div
      class="alert alert-success flex-col items-stretch gap-3"
      role="status"
      hidden
      data-app-password-reveal
    >
      <p class="text-sm font-semibold">
        Copy your new app password now. You will not see it again.
      </p>
      <div class="flex items-center gap-2">
        <input
          type="text"
          readonly
          class="input input-bordered input-sm w-full font-mono text-base-content bg-base-100"
          aria-label="New app password"
          data-app-password-value
        />
        <Button
          type="button"
          variant="outline"
          size="sm"
          className="bg-base-100"
          data-copy-app-password
        >
          <Copy size={16} class="stroke-current" aria-hidden="true" />
          Copy
        </Button>
      </div>
    </div>

    <div data-app-passwords-list>
      <SecurityAppPasswordsListPartial appPasswords={appPasswords} />
    </div>
  </div>

  <dialog
    slot="after"
    class="modal"
    aria-labelledby="create-app-password-title"
    data-create-app-password-modal
  >
    <div class="modal-box max-w-md">
      <h3 id="create-app-password-title" class="text-lg font-bold">
        Create app password
      </h3>

      {recentSignIn ? (
        <form method="post" class="space-y-4 pt-4" data-create-app-password-form novalidate>
          <div class="form-control">
            <label for="app-password-name" class="label">
              <span class="label-text">Name</span>
            </label>
            <input
              id="app-password-name"
              name="name"
              type="text"
              required
              maxlength={APP_PASSWORD_NAME_MAX_LENGTH}
              placeholder="Nightly import script"
              class="input input-bordered w-full"
              autocomplete="off"
            />
          </div>

          <fieldset class="space-y-2">
            <legend class="label-text mb-1">Access</legend>
            <label class="flex items-start gap-3 cursor-pointer">
              <input type="radio" name="scope" value="read" class="radio radio-sm mt-0.5" checked />
              <span class="text-sm">
                <span class="font-medium">Read only</span>
                <span class="block text-xs text-base-content/60">
                  Lists accounts, categories, transactions, budgets and the dashboard.
                </span>
              </span>
            </label>
            <label class="flex items-start gap-3 cursor-pointer">
              <input type="radio" name="scope" value="read-write" class="radio radio-sm mt-0.5" />
              <span class="text-sm">
                <span class="font-medium">Read and write</span>
                <span class="block text-xs text-base-content/60">
                  Also adds expenses and income.
                </span>
              </span>
            </label>
          </fieldset>

          <div class="form-control">
            <label for="app-password-expiry" class="label">
              <span class="label-text">Expires after</span>
            </label>
            <select id="app-password-expiry" name="expiry" class="select select-bordered w-full">
              {expiryChoices.map((choice) => (
                <option
                  value={choice.value}
                  selected={choice.value === DEFAULT_APP_PASSWORD_EXPIRY}
                >
                  {choice.label}
                </option>
              ))}
            </select>
          </div>

          <div class="modal-action">
            <button
              type="button"
              class="btn btn-ghost btn-sm rounded-2xl"
              data-close-create-app-password
            >
              Cancel
            </button>
            <Button
              type="submit"
              variant="accent"
              size="sm"
              className="rounded-2xl"
              data-submit-create-app-password
            >
              Create
            </Button>
          </div>
        </form>
      ) : (
        <div class="space-y-4 pt-4" data-app-password-reauth>
          <div class="alert alert-warning text-sm" role="alert">
            <TriangleAlert size={20} aria-hidden="true" />
            <span>
              An app password grants long-lived access, so creating one needs a sign-in from the
              last 15 minutes. Signing out also disconnects your OAuth connected apps.
            </span>
          </div>
          <div class="modal-action">
            <button
              type="button"
              class="btn btn-ghost btn-sm rounded-2xl"
              data-close-create-app-password
            >
              Cancel
            </button>
            <Button
              type="button"
              variant="accent"
              size="sm"
              className="rounded-2xl"
              data-app-password-sign-in-again
            >
              Sign in again
            </Button>
          </div>
        </div>
      )}
    </div>
    <form method="dialog" class="modal-backdrop">
      <button>close</button>
    </form>
  </dialog>

  <dialog
    slot="after"
    class="modal"
    aria-labelledby="revoke-app-password-title"
    data-revoke-app-password-modal
  >
    <div class="modal-box max-w-sm">
      <h3 id="revoke-app-password-title" class="text-lg font-bold">
        Revoke app password
      </h3>
      <p class="py-4 text-sm text-base-content/70">
        Revoke <strong data-revoke-app-password-label></strong>? Anything using it loses access
        immediately.
      </p>
      <div class="modal-action">
        <form method="dialog">
          <button class="btn btn-ghost btn-sm rounded-2xl">Cancel</button>
        </form>
        <Button
          type="button"
          variant="danger"
          size="sm"
          className="rounded-2xl"
          data-confirm-revoke-app-password
        >
          Revoke
        </Button>
      </div>
    </div>
    <form method="dialog" class="modal-backdrop">
      <button>close</button>
    </form>
  </dialog>
</SecurityCard>

<script>
  import './SecurityAppPasswordsCard.client';
</script>
