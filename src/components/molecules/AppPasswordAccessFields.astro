---
/** Preset radios plus the custom permission checkboxes, shared by the create and edit forms. */
import {
  APP_PASSWORD_PRESETS,
  PERMISSION_GROUPS,
  type AppPasswordPreset,
} from '@/lib/app-password-access';
import { APP_PASSWORD_SCOPES } from '@/lib/mcp-app-password';
import { expandPermissionGrants, type PermissionGrant } from '@/lib/permissions/registry';

export interface Props {
  /** Keeps ids unique while the create and edit forms are both in the page. */
  idPrefix: string;
  preset: AppPasswordPreset;
  permissions: readonly PermissionGrant[];
}

const { idPrefix, preset, permissions } = Astro.props;

// Edit starts from what the token grants today; create passes none, so Custom starts empty.
const checked = new Set<string>(expandPermissionGrants(permissions));
const customId = `${idPrefix}-custom-permissions`;
const isCustom = preset === 'custom';

const presetChoices: Array<{ value: AppPasswordPreset; label: string; description: string }> = [
  ...APP_PASSWORD_SCOPES.map((scope) => ({ value: scope, ...APP_PASSWORD_PRESETS[scope] })),
  { value: 'custom', label: 'Custom', description: 'Pick each permission yourself.' },
];
---

<div class="space-y-3" data-app-password-access>
  <fieldset class="space-y-2">
    <legend class="label-text mb-1">Access</legend>
    {presetChoices.map((choice) => (
      <label class="flex items-start gap-3 cursor-pointer">
        <input
          type="radio"
          name="preset"
          value={choice.value}
          class="radio radio-sm mt-0.5"
          checked={choice.value === preset}
          aria-controls={choice.value === 'custom' ? customId : undefined}
          data-app-password-preset
        />
        <span class="text-sm">
          <span class="font-medium">{choice.label}</span>
          <span class="block text-xs text-base-content/60">{choice.description}</span>
        </span>
      </label>
    ))}
  </fieldset>

  <fieldset
    id={customId}
    class="space-y-4 rounded-2xl border border-base-300 bg-base-200/40 p-3 sm:p-4"
    hidden={!isCustom}
    disabled={!isCustom}
    data-app-password-custom-permissions
  >
    <legend class="sr-only">Custom permissions</legend>
    {PERMISSION_GROUPS.map((group) => (
      <fieldset class="space-y-2">
        <legend class="mb-1 text-xs font-semibold text-base-content/70">{group.label}</legend>
        {group.permissions.map((permission) => (
          <label class="flex items-start gap-3 cursor-pointer">
            <input
              type="checkbox"
              name="permissions"
              value={permission.id}
              class="checkbox checkbox-sm mt-0.5"
              checked={checked.has(permission.id)}
            />
            <span class="text-sm">
              <span class="font-medium">{permission.label}</span>
              <span class="block text-xs text-base-content/60">{permission.description}</span>
            </span>
          </label>
        ))}
      </fieldset>
    ))}
  </fieldset>
</div>
