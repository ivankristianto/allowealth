---
/**
 * Calculator summary figure, such as Total Interest (success) or Final Balance (primary).
 */

import { formatCurrency } from '@/lib/formatting/currency-core';

export interface Props {
  label: string;
  value: number | string;
  variant?: 'success' | 'primary' | 'warning' | 'error';
  currency?: Currency;
  className?: string;
  id?: string;
}

const {
  label,
  value,
  variant = 'primary',
  currency = 'IDR',
  className = '',
  id = '',
} = Astro.props;

const variantStyles: Record<string, string> = {
  success: 'bg-success/10 border-success/20 text-success',
  primary: 'bg-primary/10 border-primary/20 text-primary',
  warning: 'bg-warning/10 border-warning/20 text-warning',
  error: 'bg-error/10 border-error/20 text-error',
};

const numericValue = typeof value === 'string' ? parseFloat(value) : value;
---

<div id={id} class:list={['p-6 rounded-3xl border', variantStyles[variant], className]}>
  <p class="text-xs font-bold uppercase tracking-widest mb-2 opacity-80">{label}</p>
  <h4 class="text-2xl font-bold">{formatCurrency(numericValue, currency)}</h4>
</div>
