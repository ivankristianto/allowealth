---
/** Optional write limits, shared by the create and edit forms: a category allowlist and own transactions only. */
import {
  limitCategoryGroups,
  type AppPasswordLimits,
  type LimitCategory,
} from '@/lib/app-password-limits';

export interface Props {
  /** Keeps ids unique while the create and edit forms are both in the page. */
  idPrefix: string;
  limits: AppPasswordLimits;
  categories: readonly LimitCategory[];
}

const { idPrefix, limits, categories } = Astro.props;

const pickerId = `${idPrefix}-limit-categories`;
const hasCategoryLimit = limits.category_ids !== undefined;
const listed = new Set(limits.category_ids ?? []);
const groups = limitCategoryGroups(categories, limits);
---

<fieldset class="space-y-3" data-app-password-limits>
  <legend class="label-text mb-1">
    Limits <span class="text-base-content/60">(optional)</span>
  </legend>
  <p class="text-xs text-base-content/60">
    Limits narrow what the token may change. It still reads everything its permissions allow.
  </p>

  <label class="flex items-start gap-3 cursor-pointer">
    <input
      type="checkbox"
      name="limit_categories"
      class="checkbox checkbox-sm mt-0.5 rounded-md"
      checked={hasCategoryLimit}
      aria-controls={pickerId}
      data-app-password-category-limit
    />
    <span class="text-sm">
      <span class="font-medium">Only these categories</span>
      <span class="block text-xs text-base-content/60">
        Adding, editing or deleting a transaction, and adding or editing a recurring bill, needs a
        ticked category. Transfers are refused.
      </span>
    </span>
  </label>

  <fieldset
    id={pickerId}
    class="ml-7 rounded-2xl border border-base-300 bg-base-200/40"
    hidden={!hasCategoryLimit}
    disabled={!hasCategoryLimit}
    data-app-password-limit-categories
  >
    <legend class="sr-only">Allowed categories</legend>
    <div class="max-h-56 space-y-4 overflow-y-auto p-3 sm:p-4">
      {groups.length === 0 ? (
        <p class="text-xs text-base-content/60">This workspace has no categories yet.</p>
      ) : (
        groups.map((group) => (
          <fieldset class="space-y-2">
            <legend class="mb-1 text-xs font-semibold text-base-content/70">{group.label}</legend>
            {group.categories.map((category) => (
              <label class="flex items-center gap-3 cursor-pointer">
                <input
                  type="checkbox"
                  name="category_ids"
                  value={category.id}
                  class="checkbox checkbox-sm rounded-md"
                  checked={listed.has(category.id)}
                />
                <span class="text-sm">
                  {category.name}
                  {!category.is_active && (
                    <span class="text-xs text-base-content/60"> (inactive)</span>
                  )}
                </span>
              </label>
            ))}
          </fieldset>
        ))
      )}
    </div>
  </fieldset>

  <label class="flex items-start gap-3 cursor-pointer">
    <input
      type="checkbox"
      name="own_transactions_only"
      class="checkbox checkbox-sm mt-0.5 rounded-md"
      checked={limits.own_transactions_only === true}
    />
    <span class="text-sm">
      <span class="font-medium">Only its own transactions</span>
      <span class="block text-xs text-base-content/60">
        Edits and deletes reach only transactions this app password created.
      </span>
    </span>
  </label>
</fieldset>
