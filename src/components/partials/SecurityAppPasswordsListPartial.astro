---
/**
 * App passwords list. Rendered on /security and as the ?_render=html fragment
 * of GET /api/user/app-passwords.
 */
import { KeyRound, Trash } from '@lucide/astro';
import Button from '@/components/atoms/Button.astro';
import type { AppPasswordSummary } from '@/services/mcp-app-password.service';

export interface Props {
  appPasswords: AppPasswordSummary[];
}

const { appPasswords } = Astro.props;

function formatDate(date: Date): string {
  return new Date(date).toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  });
}
---

{appPasswords.length === 0 ? (
  <p class="text-sm text-base-content/50 py-4 text-center" data-app-passwords-empty>
    No app passwords yet.
  </p>
) : (
  <ul class="border border-base-300 rounded-2xl overflow-hidden divide-y divide-base-300 bg-base-100">
    {appPasswords.map((appPassword) => (
      <li
        class="flex items-center justify-between gap-4 p-4"
        data-app-password-item
        data-app-password-id={appPassword.id}
      >
        <div class="flex items-center gap-4 min-w-0">
          <div class="rounded-xl bg-base-200 p-2 text-base-content/60 shrink-0">
            <KeyRound size={18} class="stroke-current" aria-hidden="true" />
          </div>
          <div class="min-w-0">
            <div class="flex flex-wrap items-center gap-2">
              <p class="text-sm font-semibold truncate">{appPassword.name}</p>
              <span
                class:list={[
                  'badge badge-sm shrink-0',
                  appPassword.scope === 'read' ? 'badge-ghost' : 'badge-warning badge-outline',
                ]}
              >
                {appPassword.scope === 'read' ? 'Read only' : 'Read and write'}
              </span>
              {appPassword.isExpired && (
                <span class="badge badge-sm badge-error shrink-0">Expired</span>
              )}
            </div>
            <p class="text-xs text-base-content/60">
              <code class="font-mono">{appPassword.tokenHint}…</code>
            </p>
            <div class="flex flex-wrap gap-x-3 gap-y-0.5 text-xs text-base-content/60">
              <span>Created {formatDate(appPassword.createdAt)}</span>
              <span>
                {appPassword.lastUsedAt
                  ? `Last used ${formatDate(appPassword.lastUsedAt)}`
                  : 'Never used'}
              </span>
              <span>
                {appPassword.expiresAt
                  ? `${appPassword.isExpired ? 'Expired' : 'Expires'} ${formatDate(appPassword.expiresAt)}`
                  : 'Never expires'}
              </span>
            </div>
          </div>
        </div>
        <Button
          type="button"
          variant="ghost"
          size="sm"
          className="text-error shrink-0"
          aria-label={`Revoke ${appPassword.name}`}
          data-revoke-app-password
          data-app-password-id={appPassword.id}
          data-app-password-name={appPassword.name}
        >
          <Trash size={16} class="stroke-current" aria-hidden="true" />
          <span class="hidden sm:inline">Revoke</span>
        </Button>
      </li>
    ))}
  </ul>
)}
