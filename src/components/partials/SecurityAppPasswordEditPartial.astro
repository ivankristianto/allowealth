---
/** Edit form for one app password, the ?_render=html fragment of GET /api/user/app-passwords/:id. */
import Button from '@/components/atoms/Button.astro';
import AppPasswordAccessFields from '@/components/molecules/AppPasswordAccessFields.astro';
import AppPasswordReauthNotice from '@/components/molecules/AppPasswordReauthNotice.astro';
import { APP_PASSWORD_NAME_MAX_LENGTH } from '@/lib/mcp-app-password';
import type { AppPasswordSummary } from '@/services/mcp-app-password.service';

export interface Props {
  appPassword: AppPasswordSummary;
  recentSignIn: boolean;
}

const { appPassword, recentSignIn } = Astro.props;
---

{recentSignIn ? (
  <form
    method="post"
    class="space-y-4 pt-4"
    data-edit-app-password-form
    data-app-password-id={appPassword.id}
    novalidate
  >
    <div class="form-control">
      <label for="edit-app-password-name" class="label">
        <span class="label-text">Name</span>
      </label>
      <input
        id="edit-app-password-name"
        name="name"
        type="text"
        required
        maxlength={APP_PASSWORD_NAME_MAX_LENGTH}
        value={appPassword.name}
        class="input input-bordered w-full"
        autocomplete="off"
      />
    </div>

    <AppPasswordAccessFields
      idPrefix="edit-app-password"
      preset={appPassword.preset}
      permissions={appPassword.permissions}
    />

    <p class="text-xs text-base-content/60">
      Changes apply from the token's next request. The token itself stays the same.
    </p>

    <div class="modal-action">
      <button type="button" class="btn btn-ghost btn-sm rounded-2xl" data-close-app-password-dialog>
        Cancel
      </button>
      <Button
        type="submit"
        variant="accent"
        size="sm"
        className="rounded-2xl"
        data-submit-edit-app-password
      >
        Save
      </Button>
    </div>
  </form>
) : (
  <AppPasswordReauthNotice message="Changing what an app password can do needs a sign-in from the last 15 minutes." />
)}
