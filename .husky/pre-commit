# Checkouts still on core.hooksPath=.husky run this file without -e until bun install re-runs husky
set -e
echo "Running pre-commit quality gates..."

# Run lint-staged on staged files only
echo "▸ Running lint-staged (format, lint, stylelint on staged files)..."
bunx lint-staged

# Run typecheck on entire codebase (fast, doesn't modify files)
echo "▸ Running astro check..."
bun run typecheck

# Pinned so a checkout's .env can never point the suite at a real database
echo "▸ Running unit tests..."
DATABASE_URL=db/.test.db bun test --dots

echo "✅ Pre-commit checks passed"
