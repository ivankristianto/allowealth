---
/**
 * PublicNavbar Component
 *
 * Navigation bar for public landing pages: logo, desktop links, and a mobile
 * menu. The mobile menu is a native popover opened via popovertarget, so the
 * browser handles Escape, light dismiss, top-layer stacking, and aria-expanded.
 */

import { brandContent } from '@/lib/landing-content';
import { ArrowRight, ExternalLink, Menu, X } from '@lucide/astro';

const navLinks = [
  { label: 'Features', href: '/#features' },
  { label: 'Demo', href: 'https://preview.allowealth.io', external: true },
  { label: 'Documentation', href: 'https://docs.allowealth.io', external: true },
];
---

<nav class="fixed top-0 left-0 right-0 z-50 px-4 py-4 md:px-8" aria-label="Main navigation">
  <div
    class="max-w-7xl mx-auto flex items-center justify-between px-4 sm:px-6 py-3 bg-base-100/95 border border-base-300/20 rounded-3xl shadow-premium"
  >
    <!-- Logo and Brand -->
    <a
      href="/"
      class="flex items-center gap-3 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 rounded-lg group"
      aria-label={`${brandContent.name} - Go to homepage`}
    >
      <div
        class="w-9 h-9 flex items-center justify-center overflow-hidden rounded-xl bg-linear-to-br from-accent/10 to-accent/20 p-1.5 group-hover:from-accent/20 group-hover:to-accent/30 transition-all duration-300"
      >
        <img
          src="/favicon.svg"
          alt=""
          width="36"
          height="36"
          class="w-full h-full"
          aria-hidden="true"
        />
      </div>
      <span class="text-lg font-bold tracking-tight text-base-content">
        {brandContent.name}
      </span>
    </a>

    <!-- Desktop Navigation Links -->
    <ul class="hidden lg:flex items-center gap-10 list-none m-0 p-0">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'noopener noreferrer' : undefined}
              class="text-sm font-bold text-base-content/70 hover:text-primary transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 rounded inline-flex items-center gap-1 py-2"
            >
              {link.label}
              {link.external && <ExternalLink size={12} class="opacity-50" aria-hidden="true" />}
            </a>
          </li>
        ))
      }
    </ul>

    <!-- Mobile Menu Button — popovertarget wires up toggling and aria-expanded natively -->
    <button
      type="button"
      popovertarget="mobile-menu"
      class="lg:hidden p-2 rounded-xl text-base-content/60 hover:text-base-content hover:bg-base-200 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2"
      aria-label="Toggle navigation menu"
    >
      <Menu size={24} class="menu-icon-open" aria-hidden="true" />
      <X size={24} class="menu-icon-close" aria-hidden="true" />
    </button>
  </div>

  <!-- Mobile Menu. No display utilities here: the popover UA style must keep it hidden when closed. -->
  <div id="mobile-menu" popover class="mobile-menu" aria-label="Mobile navigation menu">
    <div
      class="bg-base-100/98 backdrop-blur-xl border border-base-300/30 rounded-3xl shadow-premium-lg p-6"
    >
      <ul class="space-y-1">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                target={link.external ? '_blank' : undefined}
                rel={link.external ? 'noopener noreferrer' : undefined}
                class="flex items-center justify-between px-4 py-4 text-base font-bold text-base-content hover:bg-base-200/50 rounded-2xl transition-colors"
              >
                <span>{link.label}</span>
                {link.external ? (
                  <ExternalLink size={18} class="text-base-content/40" aria-hidden="true" />
                ) : (
                  <ArrowRight size={18} class="text-base-content/40" aria-hidden="true" />
                )}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</nav>

<script>
  // In-page links (e.g. /#features) don't navigate away, so close the menu ourselves.
  const mobileMenu = document.getElementById('mobile-menu');

  mobileMenu?.addEventListener('click', (event) => {
    if (event.target instanceof Element && event.target.closest('a:not([target])')) {
      mobileMenu.hidePopover();
    }
  });
</script>

<style>
  /* Reset UA popover box and pin the panel below the navbar. */
  .mobile-menu {
    position: fixed;
    inset: 5.5rem 1rem auto;
    width: auto;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    overflow: visible;
  }

  /* Start below the navbar so the bar and its close button stay crisp above the dimmed page. */
  .mobile-menu::backdrop {
    inset: 5.25rem 0 0;
    background-color: color-mix(in srgb, var(--color-base-100) 50%, transparent);
    backdrop-filter: blur(4px);
  }

  .menu-icon-close,
  nav:has(.mobile-menu:popover-open) .menu-icon-open {
    display: none;
  }

  nav:has(.mobile-menu:popover-open) .menu-icon-close {
    display: block;
  }

  @media (width < 1024px) {
    :global(html:has(.mobile-menu:popover-open)) {
      overflow: hidden;
    }
  }

  @media (width >= 1024px) {
    .mobile-menu {
      display: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .mobile-menu,
    .mobile-menu::backdrop {
      transition:
        opacity 0.3s ease-out,
        translate 0.3s ease-out,
        display 0.3s allow-discrete,
        overlay 0.3s allow-discrete;
    }

    .mobile-menu:not(:popover-open) {
      opacity: 0;
      translate: 0 -0.5rem;
    }

    .mobile-menu:not(:popover-open)::backdrop {
      opacity: 0;
    }

    @starting-style {
      .mobile-menu:popover-open {
        opacity: 0;
        translate: 0 -0.5rem;
      }

      .mobile-menu:popover-open::backdrop {
        opacity: 0;
      }
    }
  }
</style>
