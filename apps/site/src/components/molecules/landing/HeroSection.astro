---
/**
 * HeroSection Component
 *
 * Landing page hero with animated typing headline, description, and CTAs.
 * Full-width centered text layout with committed forest-green gradient presence.
 */

import { ArrowRight } from '@lucide/astro';
import { heroContent } from '@/lib/landing-content';
import Button from '@/components/atoms/Button.astro';

const { typingHeadlines } = heroContent;
const firstHeadline = typingHeadlines[0] ?? '';
---

<header class="relative z-10 pt-36 sm:pt-48 pb-16 sm:pb-32 px-6 overflow-hidden">
  <!-- Background — committed forest presence -->
  <div
    class="absolute inset-0 pointer-events-none"
    style="background: radial-gradient(ellipse 80% 80% at 0% 0%, color-mix(in srgb, var(--color-accent) 15%, transparent) 0%, transparent 60%), radial-gradient(ellipse 50% 50% at 100% 100%, color-mix(in srgb, var(--color-accent) 8%, transparent) 0%, transparent 70%);"
    aria-hidden="true"
  >
  </div>

  <div class="relative max-w-7xl mx-auto text-center">
    <!-- Label -->
    <span
      class="inline-block text-sm font-bold text-accent uppercase tracking-widest mb-8 sm:mb-12"
    >
      {heroContent.badge}
    </span>

    <!-- Main Headline with Typing Animation -->
    <h1
      class="text-5xl sm:text-7xl md:text-8xl lg:text-9xl font-black tracking-tighter text-base-content leading-[0.88] mb-6 sm:mb-10"
    >
      <span class="sr-only">{typingHeadlines.join(', ')} {heroContent.titleSuffix}</span>
      <span
        class="hero-typing-wrapper"
        data-headlines={JSON.stringify(typingHeadlines)}
        aria-hidden="true"
      >
        {
          /* Invisible copies of every headline share one grid cell, so the box always fits
            the longest headline at the current width. The visible line renders every
            character up front and the script only toggles their visibility, so typing
            never reflows text and never causes layout shift. */
        }
        {
          typingHeadlines.map((headline) => (
            <span class="hero-typing-sizer">
              {[...headline].map((char) => (
                <span>{char}</span>
              ))}
            </span>
          ))
        }
        <span class="hero-typing-line">
          {
            [...firstHeadline].map((char, index, chars) => (
              <span data-caret={index === chars.length - 1 ? 'end' : undefined}>{char}</span>
            ))
          }
        </span>
      </span>
      <span class="text-accent" aria-hidden="true">{heroContent.titleSuffix}</span>
    </h1>

    <!-- Description -->
    <p
      class="text-base-content/70 text-base sm:text-lg md:text-2xl font-medium max-w-3xl mx-auto leading-relaxed mb-10 sm:mb-16"
    >
      {heroContent.description}
    </p>

    <!-- CTA Buttons -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-6">
      <Button
        variant="primary"
        href={heroContent.ctaGuestHref}
        size="xl"
        className="w-full sm:w-auto"
      >
        <span>{heroContent.ctaGuest}</span>
        <ArrowRight size={20} class="stroke-current" aria-hidden="true" />
      </Button>

      <Button
        variant="secondary"
        href={heroContent.ctaSecondaryHref ?? '#showcase'}
        size="xl"
        className="w-full sm:w-auto"
      >
        {heroContent.ctaSecondary}
      </Button>
    </div>
  </div>
</header>

<script>
  // Typing animation for the hero headline. Every character of the current headline is
  // already in the DOM; typing toggles visibility only, so text never reflows.
  // Starts from the server-rendered first headline. Disabled for reduced motion.
  const TYPING_SPEED = 60;
  const DELETING_SPEED = 40;
  const PAUSE_AFTER_TYPE = 3000;
  const PAUSE_AFTER_DELETE = 500;

  const wrapper = document.querySelector<HTMLElement>('.hero-typing-wrapper');
  const line = wrapper?.querySelector<HTMLElement>('.hero-typing-line');
  const parsedHeadlines: unknown = JSON.parse(wrapper?.dataset.headlines ?? '[]');
  const headlines = Array.isArray(parsedHeadlines) ? parsedHeadlines.map(String) : [];
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (line && headlines.length > 1 && !prefersReducedMotion) {
    let charSpans = Array.from(line.children) as HTMLElement[];
    let currentIndex = 0;
    let visibleCount = charSpans.length;
    let isTyping = false;
    let timeoutId: ReturnType<typeof setTimeout> | undefined;

    const render = () => {
      charSpans.forEach((charSpan, index) => {
        charSpan.toggleAttribute('data-hidden', index >= visibleCount);
        charSpan.removeAttribute('data-caret');
      });
      if (visibleCount > 0) charSpans[visibleCount - 1].dataset.caret = 'end';
      else if (charSpans[0]) charSpans[0].dataset.caret = 'start';
    };

    const loadHeadline = (text: string) => {
      charSpans = Array.from(text, (character) => {
        const charSpan = document.createElement('span');
        charSpan.textContent = character;
        return charSpan;
      });
      line.replaceChildren(...charSpans);
    };

    const scheduleNext = (delay: number) => {
      timeoutId = setTimeout(step, delay);
    };

    function step() {
      if (isTyping && visibleCount < charSpans.length) {
        visibleCount++;
        render();
        scheduleNext(TYPING_SPEED);
      } else if (isTyping) {
        isTyping = false;
        scheduleNext(PAUSE_AFTER_TYPE);
      } else if (visibleCount > 0) {
        visibleCount--;
        render();
        scheduleNext(DELETING_SPEED);
      } else {
        currentIndex = (currentIndex + 1) % headlines.length;
        loadHeadline(headlines[currentIndex]);
        isTyping = true;
        render();
        scheduleNext(PAUSE_AFTER_DELETE);
      }
    }

    document.addEventListener('visibilitychange', () => {
      clearTimeout(timeoutId);
      if (!document.hidden) scheduleNext(PAUSE_AFTER_DELETE);
    });

    scheduleNext(PAUSE_AFTER_TYPE);
  }
</script>

<style>
  .hero-typing-wrapper {
    display: grid;
    text-wrap: balance;
    overflow-wrap: break-word;
  }

  .hero-typing-wrapper > * {
    grid-area: 1 / 1;
  }

  .hero-typing-sizer {
    visibility: hidden;
  }

  /* Shorter headlines sit in the middle of the reserved box instead of leaving a gap below. */
  .hero-typing-line {
    align-self: center;
  }

  /* Characters are created at runtime too, so match them without scoped attributes. */
  .hero-typing-line > :global([data-hidden]) {
    visibility: hidden;
  }

  .hero-typing-line > :global([data-caret]) {
    position: relative;
  }

  /* Absolutely positioned caret sits after (or before) its character without taking up space. */
  .hero-typing-line > :global([data-caret='end'])::after,
  .hero-typing-line > :global([data-caret='start'])::before {
    content: '|';
    position: absolute;
    visibility: visible;
    color: var(--color-accent);
  }

  .hero-typing-line > :global([data-caret='start'])::before {
    right: 100%;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-typing-line > :global([data-caret])::after,
    .hero-typing-line > :global([data-caret])::before {
      animation: blink 1s step-end infinite;
    }
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
</style>
