---
/**
 * FaqSection Component
 *
 * FAQ built on native <details name="faq"> (exclusive accordion, keyboard and
 * find-in-page support for free). Opening animates via ::details-content and
 * entrance effects use scroll-driven animations — no client JavaScript.
 */

import { faqItems } from '@/lib/landing-content';
import { ArrowRight, Plus } from '@lucide/astro';
---

<section
  id="faq"
  class="relative z-10 px-6 py-24 sm:py-32 bg-base-100 overflow-hidden"
  aria-labelledby="faq-title"
>
  <!-- Background decoration — lightweight radial, no blur compositing -->
  <div
    class="absolute inset-0 pointer-events-none"
    style="background: radial-gradient(ellipse 60% 40% at 50% 0%, color-mix(in srgb, var(--color-accent) 5%, transparent) 0%, transparent 70%);"
    aria-hidden="true"
  >
  </div>

  <div class="relative max-w-4xl mx-auto">
    <!-- Section Header -->
    <header class="faq-reveal mb-16 sm:mb-24 max-w-2xl">
      <h2
        id="faq-title"
        class="text-4xl sm:text-5xl md:text-7xl font-black text-base-content tracking-tighter mb-6 leading-[1.1]"
      >
        Clear answers,<br />
        <span class="text-accent italic">no confusion.</span>
      </h2>
      <p class="text-base-content/70 text-lg sm:text-xl font-medium max-w-xl">
        Everything you need to know before you take control of your finances.
      </p>
    </header>

    <!-- FAQ Accordion -->
    <div class="space-y-4 sm:space-y-6">
      {
        faqItems.map((item) => (
          <details
            name="faq"
            class="faq-item faq-reveal group rounded-3xl bg-base-200/50 border border-base-300/50 hover:border-accent/30 hover:bg-base-200 transition-colors duration-300 overflow-hidden"
          >
            <summary class="flex w-full cursor-pointer list-none items-center justify-between gap-8 p-6 sm:p-8 text-left rounded-3xl focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-base-100">
              <h3 class="text-xl sm:text-2xl font-bold text-base-content tracking-tight">
                {item.question}
              </h3>
              <span
                class="faq-icon-wrapper shrink-0 w-10 h-10 rounded-full bg-base-100 border border-base-300 flex items-center justify-center text-base-content/60 group-hover:text-accent group-hover:border-accent/30"
                aria-hidden="true"
              >
                <Plus size={20} class="faq-icon" />
              </span>
            </summary>
            <div class="p-6 sm:p-8 pt-0 text-base-content/70 sm:text-lg leading-relaxed border-t border-base-300/30">
              <p>{item.answer}</p>
            </div>
          </details>
        ))
      }
    </div>

    <!-- Secondary CTA -->
    <div class="faq-reveal mt-20 text-center">
      <div
        class="inline-flex flex-col sm:flex-row items-center justify-center gap-4 p-8 rounded-3xl bg-base-200/80 border border-base-300/80 shadow-sm w-full relative overflow-hidden group"
      >
        <!-- Glow effect -->
        <div
          class="absolute inset-0 bg-linear-to-r from-accent/0 via-accent/5 to-info/0 opacity-0 group-hover:opacity-100 transition-opacity duration-700 pointer-events-none"
        >
        </div>

        <p class="text-base-content text-lg font-bold relative z-10">Still have questions?</p>
        <div class="hidden sm:block w-1 h-1 rounded-full bg-base-content/20 relative z-10"></div>
        <a
          href="https://github.com/ivankristianto/allowealth/issues"
          target="_blank"
          rel="noopener noreferrer"
          class="relative z-10 inline-flex items-center gap-2 text-accent font-bold hover:text-accent-hover transition-colors"
        >
          <span>Ask us on GitHub</span>
          <ArrowRight
            size={16}
            class="transition-transform motion-safe:group-hover:translate-x-1"
            aria-hidden="true"
          />
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-icon-wrapper {
    transition-property: color, background-color, border-color;
    transition-duration: 300ms;
    transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
  }

  .faq-item[open] .faq-icon-wrapper {
    color: var(--color-accent-content);
    background-color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .faq-item[open] .faq-icon {
    rotate: 45deg;
  }

  /*
   * Answer height animation. Browsers without ::details-content drop this rule and
   * toggle instantly; browsers without interpolate-size also toggle instantly.
   */
  .faq-item::details-content {
    block-size: 0;
    overflow-y: clip;
  }

  .faq-item[open]::details-content {
    block-size: auto;
  }

  @media (prefers-reduced-motion: no-preference) {
    .faq-item {
      interpolate-size: allow-keywords;
    }

    .faq-item::details-content {
      transition:
        block-size 0.4s cubic-bezier(0.32, 0.72, 0, 1),
        content-visibility 0.4s allow-discrete;
    }

    .faq-icon {
      transition: rotate 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* Scroll-driven entrance; content is fully visible where unsupported. */
    @supports (animation-timeline: view()) {
      .faq-reveal {
        animation: faq-reveal linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 80%;
      }
    }
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      translate: 0 2rem;
    }
  }
</style>
